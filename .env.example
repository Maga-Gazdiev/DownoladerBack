# Copy to .env and fill secrets. Application reads environment variables.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WEB_API_TOKEN=
HTTP_ADDR=:8085
HTTP_PORT=8085
YT_DLP_BIN=yt-dlp
YOUTUBE_COOKIES_BROWSER=
YOUTUBE_COOKIES_FILE=
TELEGRAM_API_URL=https://api.telegram.org
MAX_CONCURRENT_DOWNLOADS=2
MAX_WEB_JOBS=100
MAX_UPLOAD_BYTES=50000000
MAX_MEMORY_BYTES=200000000
DOWNLOAD_TIMEOUT=20m
SEND_TIMEOUT=5m
WEB_FILE_TTL=10m
