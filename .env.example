# Copy to .env and fill values; the application reads environment, not this file.
# Full AMQP URL; URL-encode username/password and vhost as needed.
RABBIT_AMQP_URL=amqp://CHANGE_ME:CHANGE_ME@host.docker.internal:5672/%2F
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Isolate from the existing downloaderpr service and its incompatible job schema.
# Empty prefix gives video.download and telegram.send.
QUEUE_PREFIX=myversion.
HTTP_ADDR=:8085
HTTP_PORT=8085
DOWNLOAD_DIR=/data/downloads
VIDEO_BACKEND=yt-dlp
# Applied by VIDEO_BACKEND=gostreampuller; CLI backend retains original options.
VIDEO_FORMAT=mp4
VIDEO_RESOLUTION=720
VIDEO_CODEC=avc1
YT_DLP_BIN=yt-dlp
GALLERY_DL_BIN=gallery-dl
# Empty disables browser cookies (required in a container without Chrome).
YOUTUBE_COOKIES_BROWSER=chrome
MAX_RETRIES=3
DOWNLOAD_TIMEOUT=20m
SEND_TIMEOUT=5m
MAX_UPLOAD_BYTES=50000000
TELEGRAM_API_URL=https://api.telegram.org

# Random secret shared with the frontend server (never sent to the browser).
WEB_API_TOKEN=CHANGE_ME
WEB_FILE_TTL=24h
# Cleanup runs at startup and then periodically; active Web jobs/files are protected.
# Default: 1m for local disk, 30m for B2.
CLEANUP_INTERVAL=1m
# Empty uses anonymous downloads; file must use Netscape cookies format.
YOUTUBE_COOKIES_FILE=
# Example container path: /run/downloader-secrets/youtube.txt

# Optional persistent web job/video storage (private Backblaze B2 bucket).
# On Render set all four values as service Environment variables; local .env is not deployed.
# KEYNAME is only a label in Backblaze and is not needed.
B2_ENDPOINT=
B2_BUCKET=
KEYID=
APPLICATIONKEY=
